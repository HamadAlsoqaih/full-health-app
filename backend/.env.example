# ─────────────────────────────────────────────────────────────────────────────
# Backend environment.
#
# Copy this to backend/.env and fill in what you need:
#     cp backend/.env.example backend/.env
#
# backend/.env is gitignored and must never be committed.
#
# ONLY Supabase is required. Every other credential is optional: each subsystem
# derives an "enabled" flag from whether its key is present, and a missing key
# degrades exactly one feature instead of stopping the app. That is why the test
# suite passes with this file absent entirely.
#
# Where each value comes from: docs/SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call this API.
# In production set this to your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173


# ── Supabase — REQUIRED ──────────────────────────────────────────────────────
# Dashboard → Project Settings → API
#
# The app will refuse to start without SUPABASE_URL and SUPABASE_ANON_KEY.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# ⚠️  SERVICE ROLE KEY — BYPASSES ROW-LEVEL SECURITY ENTIRELY.
#
# A query made with this key can read and write every user's data regardless of
# any policy. It belongs in this file and nowhere else: never in frontend/.env,
# never in a browser, never committed.
#
# In this codebase its use is confined to src/config/supabaseAdmin.ts and
# enforced by an eslint rule. It is needed for the exercise seed script and for
# shared food-cache writes, which have no owning user to scope to.
SUPABASE_SERVICE_ROLE_KEY=


# ── AI — optional ────────────────────────────────────────────────────────────
# Powers meal-photo calorie estimates and the written check-in summaries.
#
# Leave AI_PROVIDER=stub (or leave the key blank) and the app selects a
# deterministic stub provider: photo scanning returns an obvious placeholder and
# summaries fall back to the numbers without prose. The body-composition
# analysis itself is plain arithmetic and is UNAFFECTED either way.
#
# Set to: gemini | groq | stub
AI_PROVIDER=stub

# https://aistudio.google.com/apikey — handles both vision and text.
#
# GEMINI_MODEL: leave as-is unless a scan starts failing with a 404 saying the
# model "is no longer available to new users" — Google retires models for new
# keys while still listing them, so the listing is not a valid check. The error
# names its replacement; put that here. `npm run check:services` catches it.
# Alternative: gemini-flash-latest never retires but can change without notice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# https://console.groq.com/keys — TEXT ONLY. With Groq selected, photo scanning
# correctly reports itself unavailable rather than inventing an estimate.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Account-wide daily ceiling on AI vision calls.
#
# This exists because the upstream quota is shared by the WHOLE deployment, not
# per user — without it, one enthusiastic user can exhaust the allowance for
# everybody. Check your provider's current limit and set this below it.
AI_VISION_DAILY_LIMIT=1200


# ── Food database — optional ─────────────────────────────────────────────────
# https://fdc.nal.usda.gov/api-key-signup.html (arrives by email)
#
# Without it the USDA source is skipped and search falls back to Open Food Facts,
# the cache, and the user's own custom foods. Open Food Facts needs no key and is
# always enabled.
#
# Note: both upstreams rate-limit per IP, and your API egresses from one IP, so
# every user shares one bucket. That is why all lookups are cached first.
USDA_FDC_API_KEY=


# ── Error tracking — optional ────────────────────────────────────────────────
# Sentry → your NODE project → Settings → Client Keys (DSN).
#
# Use the Node project's DSN here; the React project's DSN goes in
# frontend/.env as VITE_SENTRY_DSN. With no DSN, Sentry is a no-op.
SENTRY_DSN=

# 0 disables performance tracing. Raise cautiously — it consumes event quota.
SENTRY_TRACES_SAMPLE_RATE=0


# ── Push notifications — optional ────────────────────────────────────────────
# OneSignal → Settings → Keys & IDs.
#
# The App ID is public and also goes in frontend/.env. The REST API key is a
# SERVER SECRET and belongs only here.
#
# Note: the frontend does not yet load the OneSignal SDK, so nothing is sent
# even with these set. See docs/REMAINING-WORK.md §2.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=


# ── Uploads ──────────────────────────────────────────────────────────────────
# Maximum meal-photo size in bytes (default 8 MB). An unbounded upload endpoint
# on a small instance is a trivial denial of service, so this is enforced.
PHOTO_MAX_BYTES=8388608


# ── Payments ─────────────────────────────────────────────────────────────────
# Not integrated. The Premium card in Settings takes no money and says so.
# Uncomment only when a real gateway is wired up (docs/REMAINING-WORK.md §1).
# MOYASAR_SECRET_KEY=
