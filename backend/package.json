{
  "name": "@app/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for the fitness / nutrition / body-composition app",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:exercises": "tsx src/scripts/seed-exercises.ts"
  },
  "dependencies": {
    "@app/shared-types": "*",
    "@google/genai": "^2.22.0",
    "@sentry/node": "^10.74.0",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.27.0",
    "eslint": "^10.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
