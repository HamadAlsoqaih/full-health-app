# Frontend environment. Only values that are safe in a public bundle belong here:
# Vite inlines every VITE_* variable into the build, so anything here is readable
# by anyone who loads the app. Server-side API keys must never appear.

# Base URL of the API. Leave blank for same-origin (the dev server proxies it).
VITE_API_BASE_URL=http://localhost:8080

# Sentry's browser DSN. Public by design — it identifies a project for ingest and
# grants nothing else. This is NOT the same as a Sentry auth token.
VITE_SENTRY_DSN=

# OneSignal app id. Public: it identifies the app to the push SDK. The OneSignal
# REST API key is a server secret and belongs only in the backend environment.
VITE_ONESIGNAL_APP_ID=
